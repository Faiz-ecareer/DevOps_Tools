# General
docker info                                 # Broader information about the Docker Daemon
docker version                              # Client and Server version in detail
docker --help                               # Docker commands references
systemctl enable --now docker               # Start and enable the Docker daemon to start at reboot
systemctl status docker                     # Check daemon status

# Images
docker images                               # List all Docker images stored locally.
docker pull <image>                         # Pull image from Registry.
docker push <image>                         # Push image to Registry.
docker rmi <image>                          # Delete image from the list.
docker image prune                          # Delete dangling images from the list.
docker image prune -a                       # Delete all the images from the list.
docker tag <image:ver> <new_name:ver>       # Rename an image (If no ":" is used, it defaults to ":latest")

# Containers
docker ps                                   # Lists running containers.
docker ps -a                                # Lists all containers.
docker run <image>                          # Pulls & runs the container (official) in attached mode (stdout/stderr).
docker run <username/image>                 # Pulls & runs the container (private) in attached mode (stdout/stderr).
docker run --name <container_name> <image>  # Pulls & runs with a custom named container in attached mode (stdout/stderr).
docker run -d <image>                       # Pulls and runs the container in detached mode (background).
docker run -it <image>                      # Pulls and runs the container with an interactive terminal (stdin, stdout/stderr).
Ctrl + P/Q                                  # Detach from the running container without closing it.
docker attach <container_name/id>           # Reattach to the running container's PID 1 (without creating a new process).
docker exec -it <container_name> <shell>    # Start a new shell inside the running container (creates a new process).
Ctrl + C                                    # Closes the new shell inside the container.
docker start <container_name/id>            # Starts the container from the list.
docker stop <container_name/id>             # Stops the running container.
docker rename <old_name> <new_name>         # Renaming the container.
docker rm <container_name/id>               # Deletes the stopped container.
docker rm -f <container_name/id>            # Deletes a running container.
docker container prune                      # Deletes all the stopped containers (Clean up the list).

# Info and Stats
docker inspect <container/image>            # Detailed info about the object (container or image)
docker log <container_name>                 # Show logs of container

# Networking
docker run -p <host_port:con_port> <image>  # Creates & runs the container with Port Mapping (Host_port: Container_port).

